PORT=4100
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
CSV_PATH=../../data/reports.csv

# Sarvam — used by the dashboard's voice-playground endpoint and (later) by
# the post-call extraction + performance-scoring passes. Same key the
# telephony service uses; copy from apps/telephony/.env.
SARVAM_API_KEY=

# Optional TypeSafe AI Jev post-call assessment. Disabled unless all three are
# configured server-side; never expose this key to the browser.
JEV_ENABLED=false
JEV_API_KEY=
JEV_ALLOWED_ORIGINS=https://console.example.invalid
# Optional durable post-call queue. Both values are required before automatic
# assessments are scheduled; this never backfills calls before activation.
JEV_AUTO_POST_CALL_ENABLED=false
JEV_AUTO_START_AT=
