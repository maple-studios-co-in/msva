# Copy to apps/api/.env on the server, then fill in SARVAM_API_KEY.
PORT=4100

# AI brain. AGENT_LLM=on enables the real model; =off uses instant deterministic
# replies (can also be toggled live in the app). LLM_PROVIDER picks the backend:
#   anthropic = hosted Claude — FAST even on a CPU box (recommended for this VPS)
#   ollama    = local model (free, but slow on 2 vCPU)
AGENT_LLM=on
LLM_PROVIDER=anthropic

# Anthropic (used when LLM_PROVIDER=anthropic). Get a key at console.anthropic.com
ANTHROPIC_API_KEY=__PUT_YOUR_ANTHROPIC_KEY_HERE__
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Ollama (used when LLM_PROVIDER=ollama).
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_MS=30000

# Data files (paths are relative to apps/api).
CSV_PATH=../../data/reports.csv
ORDERS_PATH=../../data/orders.json
DEMO_FAILSAFE_CONFIG=../../data/demo-failsafe.json
DEMO_FAILSAFE_AUDIO=assets/demo-failsafe.mp3

# Sarvam ASR + TTS (required for real voice). Get a key at dashboard.sarvam.ai
SARVAM_API_KEY=__PUT_YOUR_SARVAM_KEY_HERE__

# Platform database (Phase 0). Postgres connection string.
DATABASE_URL=postgresql://msva:__DB_PASSWORD__@127.0.0.1:5432/msva?schema=public

# Optional Jev advisory assessments. Automatic post-call scheduling also needs
# an explicit activation time and never backfills earlier calls.
JEV_ENABLED=false
JEV_API_KEY=
JEV_ALLOWED_ORIGINS=https://console.example.invalid
JEV_AUTO_POST_CALL_ENABLED=false
JEV_AUTO_START_AT=

# Shared secret for service-to-service calls (telephony → api). Must match
# apps/telephony/.env. Generate with: openssl rand -hex 32
INTERNAL_API_TOKEN=__PUT_A_RANDOM_TOKEN_HERE__

# Console auth. Cookies are Secure in production automatically; set
# AUTH_DEV_ECHO=1 to return login codes in the API response (dev only).
# Exact origins the console and demo pages are served from, comma-separated.
# Browser sign-in and the demo's paid routes refuse any other origin, and CORS
# answers only these. Required: left empty, browser sign-in is refused.
BROWSER_ORIGINS=https://msva.maplestudios.co.in

# Voice worker contract routes (/api/internal/voice/v1), which the LiveKit worker
# calls. They answer 503 unless this is true and both keys are set, and the sweep
# that closes stalled voice calls runs while it is true. Keep it false until the
# worker is deployed. The token and key come from the secret store.
VOICE_ENABLED=false
VOICE_WORKER_API_TOKEN=
VOICE_LEASE_SIGNING_KEY=
# The single origin the later browser-signaling proxy may connect from.
VOICE_BROWSER_ORIGIN=

# Required before production email-code sign-in is enabled. Use STARTTLS on
# port 587 or implicit TLS on port 465; do not use opportunistic TLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS_MODE=starttls
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
AUTH_CODE_HASH_KEY=
AUTH_RATE_HASH_KEY=
# Reverse proxies (addresses or CIDRs) allowed to supply X-Forwarded-For. The
# API reads the header right to left from its socket peer and stops at the first
# address not listed, so proxies that append to it are safe; the header from any
# other peer is ignored. The bundled Caddyfile and nginx config proxy from this
# host, hence loopback. Left empty, every visitor shares the proxy's sign-in
# throttle. With Cloudflare's proxy on, nginx appends the Cloudflare edge
# address: also append Cloudflare's published ranges
# (https://www.cloudflare.com/ips/) and keep them current.
TRUSTED_PROXY_ADDRESSES=127.0.0.1,::1
