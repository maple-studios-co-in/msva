# Copy to deploy/livekit/.env. This template must remain disabled until all service
# routes, trusted TLS/DNS, provider access, and host networking gates are complete.
VOICE_RUNTIME_ENABLED=false
VOICE_STT_MODE=disabled

# Secret-store inputs. Do not use placeholders as live values.
LIVEKIT_URL=ws://livekit:7880
# This is for the later application signaling proxy only; do not expose raw :7880.
LIVEKIT_PUBLIC_URL=wss://replace-with-livekit-domain
LIVEKIT_INTERNAL_WS_URL=ws://livekit:7880
LIVEKIT_API_KEY=replace-with-livekit-key
LIVEKIT_API_SECRET=replace-with-livekit-secret
# Trusted explicitly advertised media node IPv4; never derived through public STUN.
LIVEKIT_NODE_IP=replace-with-trusted-node-ip
SARVAM_API_KEY=replace-with-sarvam-key
ANTHROPIC_API_KEY=replace-with-anthropic-key
VOICE_INTERNAL_API_URL=https://replace-with-msva-api/api/internal/voice/v1
VOICE_WORKER_CREDENTIAL=replace-with-scoped-worker-credential
# Base64 Fernet key held only in the worker secret store; encrypts historical
# evidence-only replay credentials in the local spool. Rotate it in the three steps
# deploy/livekit/README.md describes.
VOICE_REPLAY_CREDENTIAL_KEY=replace-with-fernet-replay-key

# Explicit bounded pilot settings.
VOICE_AGENT_NAME=madhusudan-support-v1
VOICE_CALL_LIMIT=2
VOICE_DRAIN_TIMEOUT_SECONDS=120
VOICE_LEASE_SECONDS=30
# Below the API's 5 s evidence tolerance, so an end the API decides is noticed in time.
VOICE_LEASE_RENEW_SECONDS=3
VOICE_SPOOL_PATH=/var/lib/msva-voice-agent/spool.sqlite3
VOICE_SPOOL_MAX_EVENTS=10100
VOICE_SPOOL_MAX_BYTES=52428800
