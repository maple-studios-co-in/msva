# Copy to apps/telephony/.env on the server, then fill in SARVAM_API_KEY.
TELEPHONY_PORT=4200
AGENT_BASE_URL=http://127.0.0.1:4100
AGENT_LANGUAGE=hi-IN
TTS_VOICE=neha
SARVAM_API_KEY=__PUT_YOUR_SARVAM_KEY_HERE__

# Spoken greeting for real inbound (Exotel) calls. Played via TTS the moment a
# call connects, before the caller speaks.
CALL_GREETING=Namaste! Madhusudan family se baat ho rahi hai. Main aapki AI assistant hoon. Bataiye, milk, ghee, paneer, dahi ya kisi order ke baare mein kaise madad karun?

# In-browser Live Call VAD tuning (optional; defaults shown).
BROWSER_SAMPLE_RATE=16000
BROWSER_VAD_SILENCE_MS=750
BROWSER_VAD_ENERGY_FLOOR=550
BROWSER_BARGE_IN_MS=420

# Real phone (Exotel) — only needed if you connect a DID. Exotel must reach
# this server at wss://msva.maplestudios.co.in/voice (Caddy proxies /voice).
PUBLIC_WS_HOST=msva.maplestudios.co.in
PUBLIC_WS_SCHEME=wss

# Where the api lives (for the agent stream and call logging).
AGENT_BASE_URL=http://127.0.0.1:4100
# Must match INTERNAL_API_TOKEN in apps/api/.env.
INTERNAL_API_TOKEN=__PUT_A_RANDOM_TOKEN_HERE__
# Set to true on a staging DID so its calls are stored as test traffic.
CALLS_ARE_TEST=false
