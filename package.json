{
  "name": "msva-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Madhu Sudhan Voice Agent MVP monorepo",
  "scripts": {
    "dev": "pnpm --parallel --filter @msva/api --filter @msva/web dev",
    "dev:all": "pnpm --parallel --filter @msva/api --filter @msva/web --filter @msva/telephony dev",
    "dev:api": "pnpm --filter @msva/api dev",
    "dev:web": "pnpm --filter @msva/web dev",
    "dev:telephony": "pnpm --filter @msva/telephony dev",
    "dev:docs": "pnpm --filter @msva/docs dev",
    "build:docs": "pnpm --filter @msva/docs build",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "start": "pnpm --filter @msva/api start",
    "db:generate": "pnpm --filter @msva/db generate",
    "db:migrate": "pnpm --filter @msva/db migrate",
    "db:migrate:dev": "pnpm --filter @msva/db migrate:dev",
    "db:seed": "pnpm --filter @msva/db seed",
    "db:studio": "pnpm --filter @msva/db studio",
    "test": "vitest run",
    "test:jev-db": "node -e \"const testUrl=process.env.JEV_TEST_DATABASE_URL; if (!testUrl || !process.env.DATABASE_URL || testUrl !== process.env.DATABASE_URL || !new URL(testUrl).pathname.endsWith('/msva_jev_test')) throw new Error('DATABASE_URL and JEV_TEST_DATABASE_URL must match the disposable msva_jev_test database');\" && vitest run --config vitest.jev.config.ts",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "typescript": "^5.8.3",
    "vitest": "^3"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.6.4"
}
