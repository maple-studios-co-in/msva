{
  "name": "msva-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Madhu Sudhan Voice Agent MVP monorepo",
  "scripts": {
    "dev": "pnpm --parallel --filter @msva/api --filter @msva/web dev",
    "dev:all": "pnpm --parallel --filter @msva/api --filter @msva/web --filter @msva/telephony dev",
    "dev:api": "pnpm --filter @msva/api dev",
    "dev:web": "pnpm --filter @msva/web dev",
    "dev:telephony": "pnpm --filter @msva/telephony dev",
    "dev:docs": "pnpm --filter @msva/docs dev",
    "build:docs": "pnpm --filter @msva/docs build",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "start": "pnpm --filter @msva/api start",
    "db:generate": "pnpm --filter @msva/db generate",
    "db:migrate": "pnpm --filter @msva/db migrate",
    "db:migrate:dev": "pnpm --filter @msva/db migrate:dev",
    "db:seed": "pnpm --filter @msva/db seed",
    "db:studio": "pnpm --filter @msva/db studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "contracts:export": "pnpm --filter @msva/contracts export",
    "contracts:check": "pnpm --filter @msva/contracts check",
    "test:contracts": "pnpm --filter @msva/contracts test",
    "test:voice-contracts": "cd apps/voice-agent && PYTHONDONTWRITEBYTECODE=1 uv run --frozen --python 3.12 pytest",
    "test:db": "node -e \"if (!process.env.MSVA_TEST_DATABASE_URL) { throw new Error('MSVA_TEST_DATABASE_URL is required for pnpm test:db'); }\" && vitest run --config vitest.integration.config.ts"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "typescript": "^5.8.3",
    "vitest": "^3"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.6.4"
}
