{
  "$id": "https://msva.example.invalid/contracts/demo-v1/create-request-result.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actionState": {
      "enum": [
        "RECORDED",
        "PENDING_STAFF"
      ],
      "type": "string"
    },
    "callId": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "caseId": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "evidenceState": {
      "const": "NOT_REQUESTED",
      "type": "string"
    },
    "requestId": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "ticketNumber": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
    },
    "truthState": {
      "const": "RECORDED",
      "type": "string"
    }
  },
  "required": [
    "requestId",
    "callId",
    "caseId",
    "ticketNumber",
    "truthState",
    "actionState",
    "evidenceState"
  ],
  "type": "object"
}
