{
  "$id": "https://msva.example.invalid/contracts/demo-v1/evidence.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "additionalProperties": false,
      "properties": {
        "state": {
          "const": "NOT_REQUESTED",
          "type": "string"
        },
        "truthState": {
          "const": "RECORDED",
          "type": "string"
        }
      },
      "required": [
        "state",
        "truthState"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "state": {
          "const": "REQUESTED",
          "type": "string"
        },
        "truthState": {
          "const": "RECORDED",
          "type": "string"
        }
      },
      "required": [
        "state",
        "truthState"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "state": {
          "const": "UNAVAILABLE",
          "type": "string"
        },
        "truthState": {
          "const": "UNAVAILABLE",
          "type": "string"
        }
      },
      "required": [
        "state",
        "truthState"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "fixtureRef": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "state": {
          "const": "REQUESTED",
          "type": "string"
        },
        "truthState": {
          "const": "FIXTURE",
          "type": "string"
        }
      },
      "required": [
        "state",
        "truthState",
        "fixtureRef"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "receivedAt": {
          "allOf": [
            {
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
              "type": "string"
            },
            {
              "pattern": "^(?!0000-)",
              "type": "string"
            }
          ]
        },
        "state": {
          "const": "RECEIVED",
          "type": "string"
        },
        "storageKey": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "truthState": {
          "const": "RECORDED",
          "type": "string"
        }
      },
      "required": [
        "state",
        "truthState",
        "storageKey",
        "receivedAt"
      ],
      "type": "object"
    }
  ]
}
