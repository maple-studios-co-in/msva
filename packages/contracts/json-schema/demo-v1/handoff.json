{
  "$id": "https://msva.example.invalid/contracts/demo-v1/handoff.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "additionalProperties": false,
      "properties": {
        "callId": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "state": {
          "enum": [
            "REQUESTED",
            "FAILED",
            "TIMED_OUT"
          ],
          "type": "string"
        },
        "version": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "callId",
        "version",
        "state"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "assignedUserId": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "callId": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "state": {
          "enum": [
            "ASSIGNED",
            "JOINING"
          ],
          "type": "string"
        },
        "version": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "callId",
        "version",
        "state",
        "assignedUserId"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "activatedAt": {
          "allOf": [
            {
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
              "type": "string"
            },
            {
              "pattern": "^(?!0000-)",
              "type": "string"
            }
          ]
        },
        "assignedUserId": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "callId": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "state": {
          "const": "HUMAN_ACTIVE",
          "type": "string"
        },
        "version": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "callId",
        "version",
        "state",
        "assignedUserId",
        "activatedAt"
      ],
      "type": "object"
    }
  ]
}
