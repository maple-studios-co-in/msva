{
  "name": "@msva/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm --dir ../.. exec vitest run packages/contracts/src",
    "export": "tsx src/export-demo-contracts.ts --write && tsx src/export-voice-contracts.ts --write",
    "check": "tsx src/export-demo-contracts.ts --check && tsx src/export-voice-contracts.ts --check"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
