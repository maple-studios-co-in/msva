// MSVA platform schema — Phase 0 foundations.
//
// Everything hangs off `Call`. Each call has ordered `Turn`s (one per
// caller utterance + agent reply, with latency numbers) and `Utterance`s
// (the transcript as spoken). Tickets link back to the call and caller that
// raised them. Users, sessions and login codes power the admin console;
// AuditLog records who did what.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// People who use the console
// ---------------------------------------------------------------------------

enum UserRole {
  ADMIN
  SUPERVISOR
  AGENT
  VIEWER
}

model User {
  id               String            @id @default(cuid())
  email            String            @unique
  name             String
  role             UserRole          @default(VIEWER)
  active           Boolean           @default(true)
  createdAt        DateTime          @default(now())
  lastLoginAt      DateTime?
  sessions         Session[]
  loginCodes       LoginCode[]
  tickets          Ticket[]          @relation("TicketAssignee")
  notes            TicketNote[]
  audits           AuditLog[]
  queueAssignments QueueAssignment[] @relation("QueueAssignmentAssignee")
  handoffs         Handoff[]         @relation("HandoffAssignee")
  riskAlerts       RiskAlert[]       @relation("RiskAlertOwner")
  requestedAssessments CallAssessment[] @relation("CallAssessmentRequester")
}

model LoginCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Voice agents and the people who call them
// ---------------------------------------------------------------------------

model Agent {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  channel       String   @default("voice")
  promptVersion String   @default("v1")
  voice         String   @default("neha")
  language      String   @default("hi-IN")
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  calls         Call[]
}

enum CallerType {
  DISTRIBUTOR
  RETAILER
  CUSTOMER
  FARMER
  UNKNOWN
}

model Caller {
  id               String             @id @default(cuid())
  phone            String             @unique
  name             String?
  type             CallerType         @default(UNKNOWN)
  code             String?
  area             String?
  route            String?
  notes            String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  calls            Call[]
  tickets          Ticket[]
  demoIdentities   DemoCallIdentity[]
  businessRequests BusinessRequest[]
}

// ---------------------------------------------------------------------------
// Calls
// ---------------------------------------------------------------------------

enum CallProvider {
  BROWSER
  EXOTEL
  TWILIO
}

enum CallDirection {
  INBOUND
  OUTBOUND
}

enum CallStatus {
  QUEUED
  RINGING
  IN_PROGRESS
  COMPLETED
  NO_ANSWER
  FAILED
}

enum CallOutcome {
  IN_PROGRESS
  RESOLVED_BY_VA
  TICKET_CREATED
  HUMAN_TRANSFER
  ABANDONED
}

model Call {
  // Client-supplied id: the telephony service mints a session id per call
  // and uses it for every lifecycle event, so tools can link to the row.
  id               String            @id
  provider         CallProvider
  providerSid      String?           @unique
  direction        CallDirection     @default(INBOUND)
  isTest           Boolean           @default(false)
  status           CallStatus        @default(IN_PROGRESS)
  outcome          CallOutcome       @default(IN_PROGRESS)
  agentId          String?
  agent            Agent?            @relation(fields: [agentId], references: [id])
  callerId         String?
  caller           Caller?           @relation(fields: [callerId], references: [id])
  fromNumber       String
  toNumber         String?
  callerName       String?
  callerType       CallerType        @default(UNKNOWN)
  intent           String?
  language         String?
  escalationReason String?
  collected        Json              @default("{}")
  startedAt        DateTime          @default(now())
  endedAt          DateTime?
  durationMs       Int?
  recordingKey     String?
  costPaise        Int?
  source           String?
  metadata         Json?
  turns            Turn[]
  utterances       Utterance[]
  tickets          Ticket[]
  demoIdentity     DemoCallIdentity?
  businessRequests BusinessRequest[]
  handoffs         Handoff[]
  riskAssessments  RiskAssessment[]
  assessments      CallAssessment[]
  assessmentJobs   AssessmentJob[]
  voiceSessions    VoiceSession[]

  @@index([startedAt])
  @@index([callerId])
  @@index([status])
  @@index([isTest, startedAt])
}

model Turn {
  id              String   @id @default(cuid())
  callId          String
  call            Call     @relation(fields: [callId], references: [id], onDelete: Cascade)
  index           Int
  callerText      String?
  replyText       String?
  asrMs           Int?
  llmFirstTokenMs Int?
  llmTotalMs      Int?
  ttsFirstByteMs  Int?
  ttfwMs          Int?
  interrupted     Boolean  @default(false)
  source          String?
  toolCalls       Json?
  createdAt       DateTime @default(now())

  @@unique([callId, index])
}

enum Speaker {
  CALLER
  AGENT
  HUMAN
}

model Utterance {
  id        String   @id @default(cuid())
  callId    String
  call      Call     @relation(fields: [callId], references: [id], onDelete: Cascade)
  seq       Int
  speaker   Speaker
  text      String
  atMs      Int?
  createdAt DateTime @default(now())

  @@index([callId, seq])
}

// ---------------------------------------------------------------------------
// Tickets — the built-in queue. External helpdesk sync (Phase 2) fills
// `externalRef` and mirrors status.
// ---------------------------------------------------------------------------

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
}

model Ticket {
  id                  String               @id @default(cuid())
  number              Int                  @unique @default(autoincrement())
  callId              String?
  call                Call?                @relation(fields: [callId], references: [id])
  callerId            String?
  caller              Caller?              @relation(fields: [callerId], references: [id])
  phone               String
  callerName          String?
  intent              String
  priority            TicketPriority       @default(MEDIUM)
  status              TicketStatus         @default(OPEN)
  summary             String
  details             Json?
  assigneeId          String?
  assignee            User?                @relation("TicketAssignee", fields: [assigneeId], references: [id])
  slaDueAt            DateTime?
  callbackStart       DateTime?
  callbackEnd         DateTime?
  resolutionCode      String?
  externalRef         String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  resolvedAt          DateTime?
  evidenceState       TicketEvidenceState  @default(NOT_REQUESTED)
  evidenceRequestedAt DateTime?
  notes               TicketNote[]
  businessRequests    BusinessRequest[]
  evidenceAttachments EvidenceAttachment[]

  @@index([status, priority])
  @@index([createdAt])
}

model TicketNote {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id])
  text      String
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  meta      Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entity, entityId])
}

// ---------------------------------------------------------------------------
// Demo journey foundation — passive, additive records only. These models do
// not perform provider actions or alter a Call outcome.
// ---------------------------------------------------------------------------

enum IdentityAssurance {
  UNVERIFIED
  VERIFIED
  DEMO_TRUSTED
}

enum JourneyKind {
  CONSUMER_COMPLAINT
  RETAILER_ENQUIRY
  DISTRIBUTOR_CASE
  SALES_LEAD
}

enum CallerConfirmation {
  NEW
  FOLLOW_UP
  SEPARATE
}

enum BusinessRequestTruthState {
  RECORDED
}

enum RequestActionState {
  RECORDED
  PENDING_STAFF
}

enum DemoLanguage {
  hi
  en
  hinglish
}

enum QueueAssignmentState {
  PENDING_STAFF
}

enum CallbackRequestState {
  REQUESTED
  PENDING_STAFF
  CANCELLED
}

enum TicketEvidenceState {
  NOT_REQUESTED
  REQUESTED
  RECEIVED
  UNAVAILABLE
}

enum EvidenceAttachmentState {
  REQUESTED
  RECEIVED
  UNAVAILABLE
}

enum EvidenceProvenance {
  STORED
  FIXTURE
}

enum HandoffState {
  REQUESTED
  ASSIGNED
  JOINING
  HUMAN_ACTIVE
  FAILED
  TIMED_OUT
}

enum RiskSentiment {
  NEUTRAL
  POSITIVE
  NEGATIVE
  UNKNOWN
}

enum RiskUrgency {
  ROUTINE
  POSSIBLE_SAFETY
  UNKNOWN
}

enum RiskMode {
  SHADOW
}

enum RiskSource {
  FIXTURE
  DETECTOR
}

enum RiskAlertState {
  PENDING_STAFF
  ACKNOWLEDGED
  CLOSED
}

model DemoCallIdentity {
  callId          String            @id
  call            Call              @relation(fields: [callId], references: [id], onDelete: Restrict)
  callerId        String?
  caller          Caller?           @relation(fields: [callerId], references: [id], onDelete: Restrict)
  assurance       IdentityAssurance @default(UNVERIFIED)
  verifiedAt      DateTime?
  verificationRef String?
  fixtureKey      String?
}

model BusinessRequest {
  id                 String                    @id @default(cuid())
  requestId          String                    @unique
  callId             String
  call               Call                      @relation(fields: [callId], references: [id], onDelete: Restrict)
  callerId           String?
  caller             Caller?                   @relation(fields: [callerId], references: [id], onDelete: Restrict)
  ticketId           String
  ticket             Ticket                    @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  journey            JourneyKind
  callerConfirmation CallerConfirmation
  parentRequestId    String?
  parentRequest      BusinessRequest?          @relation("BusinessRequestParent", fields: [parentRequestId], references: [id], onDelete: Restrict)
  childRequests      BusinessRequest[]         @relation("BusinessRequestParent")
  language           DemoLanguage
  territory          String
  verificationState  IdentityAssurance         @default(UNVERIFIED)
  truthState         BusinessRequestTruthState @default(RECORDED)
  actionState        RequestActionState        @default(PENDING_STAFF)
  fields             Json
  payloadCanonical   String
  payloadHash        String
  result             Json
  queueAssignment    QueueAssignment?
  callbackRequest    CallbackRequest?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  @@index([callId])
  @@index([callerId, createdAt])
  @@index([ticketId])
  @@index([parentRequestId])
}

model QueueAssignment {
  id                String               @id @default(cuid())
  businessRequestId String               @unique
  businessRequest   BusinessRequest      @relation(fields: [businessRequestId], references: [id], onDelete: Restrict)
  territory         String
  language          DemoLanguage
  queueKey          String               @default("support")
  state             QueueAssignmentState @default(PENDING_STAFF)
  assignedUserId    String?
  assignedUser      User?                @relation("QueueAssignmentAssignee", fields: [assignedUserId], references: [id], onDelete: Restrict)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
}

model CallbackRequest {
  id                String               @id @default(cuid())
  businessRequestId String               @unique
  businessRequest   BusinessRequest      @relation(fields: [businessRequestId], references: [id], onDelete: Restrict)
  state             CallbackRequestState @default(PENDING_STAFF)
  requestedAt       DateTime             @default(now())
  preferredWindow   String?
}

model EvidenceAttachment {
  id         String                  @id @default(cuid())
  ticketId   String
  ticket     Ticket                  @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  state      EvidenceAttachmentState
  provenance EvidenceProvenance
  storageKey String?
  fixtureRef String?
  receivedAt DateTime?
  createdAt  DateTime                @default(now())

  @@index([ticketId])
}

model Handoff {
  id             String       @id @default(cuid())
  callId         String
  call           Call         @relation(fields: [callId], references: [id], onDelete: Restrict)
  state          HandoffState
  version        Int          @default(1)
  assignedUserId String?
  assignedUser   User?        @relation("HandoffAssignee", fields: [assignedUserId], references: [id], onDelete: Restrict)
  requestedAt    DateTime     @default(now())
  activatedAt    DateTime?
  failureReason  String?

  @@index([callId])
}

model RiskAssessment {
  id        String        @id @default(cuid())
  callId    String
  call      Call          @relation(fields: [callId], references: [id], onDelete: Restrict)
  sentiment RiskSentiment
  urgency   RiskUrgency
  mode      RiskMode      @default(SHADOW)
  source    RiskSource
  rationale String
  alert     RiskAlert?
  createdAt DateTime      @default(now())

  @@index([callId])
}

model RiskAlert {
  id               String         @id @default(cuid())
  riskAssessmentId String         @unique
  riskAssessment   RiskAssessment @relation(fields: [riskAssessmentId], references: [id], onDelete: Restrict)
  state            RiskAlertState @default(PENDING_STAFF)
  ownerId          String?
  owner            User?          @relation("RiskAlertOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  createdAt        DateTime       @default(now())
}

enum CallAssessmentStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

model CallAssessment {
  id                   String               @id @default(cuid())
  callId               String
  call                 Call                 @relation(fields: [callId], references: [id], onDelete: Cascade)
  inputHash            String
  requestedModel       String
  returnedModel        String?
  rubricVersion        String
  preprocessingVersion String
  status               CallAssessmentStatus
  requestedById        String?
  requestedBy          User?                @relation("CallAssessmentRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  attemptToken         String
  attemptCount         Int                  @default(1)
  leaseExpiresAt       DateTime?
  errorCode            String?
  result               Json?
  inputCharCount       Int
  utteranceCount       Int
  linkedTicketRecorded Boolean              @default(false)
  inputLanguage        String?
  promptTokens         Int?
  completionTokens     Int?
  requestedAt          DateTime             @default(now())
  completedAt          DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@unique([callId, inputHash, requestedModel, rubricVersion])
  @@index([callId, requestedAt])
  @@index([status, leaseExpiresAt])
}

// ---------------------------------------------------------------------------
// Durable LiveKit worker authority. These records are deliberately separate
// from legacy CallProvider: transport describes the room, provider describes
// how the application call began.
// ---------------------------------------------------------------------------

enum VoiceTransport {
  LIVEKIT
}
enum VoiceSessionState {
  STARTING
  ACTIVE
  RECOVERY_REQUIRED
  ENDED
  FAILED
}
enum VoiceOwnershipMode {
  AI
  HUMAN
}
enum VoiceAdmissionState {
  ISSUED
  CONNECTING
  ACTIVE
  REVOKING
  REVOKED
  EXPIRED
}
enum AdmissionMediaRole {
  CALLER
  OPERATOR_LISTENER
  OPERATOR_SPEAKER
}
enum MediaControlKind {
  GRANT
  REMOVE
}
enum MediaControlStatus {
  PENDING
  RUNNING
  CONFIRMED
  FAILED
}

model VoiceSession {
  id                    String             @id @default(cuid())
  callId                String
  call                  Call               @relation(fields: [callId], references: [id], onDelete: Restrict)
  roomName              String
  transport             VoiceTransport     @default(LIVEKIT)
  ownerUserId           String?
  ownerSessionId        String?
  createRequestId       String             @unique
  createRequestHash     String
  dispatchIntentId      String             @unique
  providerDispatchId    String?
  state                 VoiceSessionState  @default(STARTING)
  ownershipMode         VoiceOwnershipMode @default(AI)
  authorizationVersion  Int                @default(1)
  currentEpoch          Int                @default(0)
  finalWatermark        Int                @default(0)
  transcriptComplete    Boolean            @default(false)
  version               Int                @default(1)
  startedAt             DateTime           @default(now())
  endedAt               DateTime?
  expiresAt             DateTime?
  language              String             @default("hi")
  prompt                String             @default("")
  participants          VoiceParticipant[]
  lease                 VoiceLease?
  events                VoiceEvent[]
  segments              TranscriptSegment[]
  admissions            VoiceAdmission[]
  toolInvocations       ToolInvocation[]
  @@unique([callId, roomName])
  @@unique([callId])
  @@index([state, expiresAt])
}

model VoiceParticipant {
  id          String       @id @default(cuid())
  sessionId   String
  session     VoiceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  identity    String
  role        Speaker
  confirmedAt DateTime?
  createdAt   DateTime     @default(now())
  @@unique([sessionId, identity])
}

model VoiceLease {
  id          String       @id @default(cuid())
  sessionId   String       @unique
  session     VoiceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  agentEpoch  Int
  tokenHash   String
  expiresAt   DateTime
  createdAt   DateTime     @default(now())
  renewedAt   DateTime     @default(now())
  @@unique([sessionId, agentEpoch])
  @@index([expiresAt])
}

model VoiceEvent {
  id              String       @id @default(cuid())
  sessionId       String
  session         VoiceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  eventId         String
  agentEpoch      Int
  sourceSequence  Int
  canonicalBody   String
  bodyHash        String
  bodyBytes       Int
  type            String
  occurredAt      DateTime
  createdAt       DateTime     @default(now())
  @@unique([sessionId, eventId])
  @@unique([sessionId, agentEpoch, sourceSequence])
}

model TranscriptSegment {
  id          String       @id @default(cuid())
  sessionId   String
  session     VoiceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  segmentId   String
  revision    Int
  speaker     Speaker
  participantId String
  sequence    Int
  text        String
  startMs     Int?
  endMs       Int?
  language    String
  isCurrent   Boolean      @default(true)
  createdAt   DateTime     @default(now())
  @@unique([sessionId, segmentId, revision])
  @@index([sessionId, sequence, isCurrent])
}

model VoiceAdmission {
  id                     String              @id @default(cuid())
  callId                 String
  voiceSessionId         String
  voiceSession           VoiceSession        @relation(fields: [voiceSessionId], references: [id], onDelete: Cascade)
  sessionId              String
  userId                 String
  participantIdentity    String              @unique
  participantSid         String?
  role                   AdmissionMediaRole
  authorizationVersion   Int
  state                  VoiceAdmissionState @default(ISSUED)
  issuedAt               DateTime            @default(now())
  firstJoinExpiresAt     DateTime
  absoluteExpiresAt      DateTime
  revokedAt              DateTime?
  revokeReason           String?
  connectionEpoch        Int                 @default(0)
  connectionOwner        String?
  connectionLeaseExpiresAt DateTime?
  lastAuthorizedAt       DateTime?
  mediaControlIntents    MediaControlIntent[]
  @@index([callId, state])
  @@index([sessionId, state])
}

model MediaControlIntent {
  id                   String             @id @default(cuid())
  admissionId          String
  admission            VoiceAdmission     @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  authorizationVersion Int
  kind                 MediaControlKind
  status               MediaControlStatus @default(PENDING)
  attemptToken         String?
  leaseExpiresAt       DateTime?
  errorCode            String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  @@index([status, leaseExpiresAt])
  @@index([admissionId, authorizationVersion, kind])
}

model ToolInvocation {
  id               String       @id @default(cuid())
  sessionId        String
  session          VoiceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  invocationId     String
  agentEpoch       Int
  name             String
  canonicalPayload String
  payloadHash      String
  status           String       @default("PENDING")
  result           Json?
  createdAt        DateTime     @default(now())
  @@unique([sessionId, invocationId])
}

enum AssessmentJobKind {
  POST_CALL
}

enum AssessmentJobState {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
}

// Durable, provider-independent post-call assessment work.  The result itself
// remains keyed in CallAssessment so manual and automatic callers share the
// same fingerprint cache and attempt fencing.
model AssessmentJob {
  id                String             @id @default(cuid())
  callId            String
  call              Call               @relation(fields: [callId], references: [id], onDelete: Cascade)
  kind              AssessmentJobKind
  state             AssessmentJobState @default(PENDING)
  generation        Int                @default(1)
  claimedGeneration Int?
  dueAt             DateTime
  leaseToken        String?
  leaseExpiresAt    DateTime?
  attempts          Int                @default(0)
  lastInputHash     String?
  reason            String?
  source            String             @default("AUTO_POST_CALL")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@unique([callId, kind])
  @@index([state, dueAt])
  @@index([leaseExpiresAt])
}

// Exactly two rows are created lazily and leased with CAS updates. They are
// shared by every API process, unlike an in-memory semaphore.
model AssessmentWorkerSlot {
  slot           Int      @id
  ownerToken     String?
  jobId          String?
  leaseExpiresAt DateTime?
  updatedAt      DateTime @updatedAt
}

// A singleton cursor keeps reconciliation bounded and rotating across calls.
model AssessmentReconciliationCursor {
  id          String   @id
  endedAt     DateTime?
  callId      String?
  updatedAt   DateTime @updatedAt
}
